# Server-side only (Vercel > Project > Settings > Environment Variables). NEVER prefix with VITE_ and never commit real values.
RESEND_API_KEY=            # API key from the email provider (https://resend.com)
CONTACT_TO_EMAIL=          # the verified RaapNexus inbox that receives enquiries
CONTACT_FROM_EMAIL=        # sender on a domain verified with the provider, e.g. RaapNexus <no-reply@your-verified-domain>
# CONTACT_SEND_ACK=false   # optional: disable the acknowledgement email to visitors
# VITE_SITE_URL=https://raap-nexus-new.vercel.app   # optional: canonical production origin used at build time
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX   # optional, build-time, public by design: Google Analytics 4 measurement ID (leave unset to disable analytics)
